<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-4 flex-grow-1">

  <!-- Executive Header Banner -->
  <div class="hero-banner p-3 p-md-5 mb-4 rounded-4 shadow-sm text-white" 
       style="background: linear-gradient(135deg, #064e3b 0%, #047857 55%, #0d9488 100%); position: relative; overflow: hidden;">
    
    <!-- Background Watermark Pattern -->
    <div style="position: absolute; right: -20px; bottom: -30px; opacity: 0.12; pointer-events: none;">
      <i class="bi bi-box-seam" style="font-size: 16rem;"></i>
    </div>

    <div class="row align-items-center position-relative" style="z-index: 1;">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-white bg-opacity-20 text-white small fw-medium backdrop-blur">
          <span class="spinner-grow spinner-grow-sm text-warning" role="status" aria-hidden="true" style="width: 8px; height: 8px;"></span>
          Certified Election Collation Active &bull; Delta State
        </div>

        <h1 class="display-5 fw-extrabold mb-2 text-white">Delta State Election Results Portal</h1>
        <p class="lead text-white text-opacity-90 mb-4" style="max-width: 620px;">
          The official public portal for verified grassroots ballot counts, council-level aggregations, and collation reconciliation across Delta State.
        </p>

        <!-- Quick Jump Filter Toolbar -->
        <div class="p-3 rounded-3 bg-black bg-opacity-25 border border-white border-opacity-20 mb-2" style="max-width: 650px;">
          <form action="/lga-total" method="GET" class="d-flex flex-column flex-sm-row gap-2 align-items-stretch">
            <select name="lga_id" class="form-select border-0 shadow-none py-2" required>
              <option value="">-- Jump Directly to Any Local Government Area (LGA) --</option>
              <% lgaSummaries.forEach(l => { %>
                <option value="<%= l.lga_id %>">
                  <%= l.lga_name %> (<%= l.reporting_pus %>/<%= l.total_pus %> units reporting)
                </option>
              <% }); %>
            </select>
            <button type="submit" class="btn btn-warning text-dark fw-bold px-4 py-2 flex-shrink-0">
              <i class="bi bi-arrow-right"></i> View Summary
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Action Shortcuts (Hero Side) -->
      <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="bg-white bg-opacity-10 p-4 rounded-4 border border-white border-opacity-20 backdrop-blur">
          <div class="text-uppercase small text-warning fw-bold mb-2 tracking-wide">
            <i class="bi bi-lightning-charge-fill me-1"></i> Quick Portals
          </div>
          <div class="d-grid gap-2">
            <a href="/polling-unit" class="btn btn-light text-success fw-bold text-start py-2 px-3 shadow-sm">
              <i class="bi bi-geo-alt-fill me-2 text-success"></i> Search Any Polling Unit
            </a>
            <a href="/lga-total" class="btn btn-outline-light text-start py-2 px-3 fw-semibold">
              <i class="bi bi-building-fill me-2"></i> LGA Collation Summaries
            </a>
            <a href="/new-polling-unit" class="btn btn-warning text-dark text-start py-2 px-3 fw-bold shadow-sm">
              <i class="bi bi-plus-circle-fill me-2"></i> Presiding Officer Submission
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Statistics KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm bg-white p-2">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-4 bg-success-subtle text-success p-3 me-3 flex-shrink-0">
            <i class="bi bi-check-circle-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium">Total Verified Votes</div>
            <div class="fs-4 fw-bold text-dark"><%= Number(stats.totalVotes || 0).toLocaleString() %></div>
            <div class="small text-success fw-semibold">Grassroots returns</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm bg-white p-2">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-4 bg-primary-subtle text-primary p-3 me-3 flex-shrink-0">
            <i class="bi bi-geo-alt-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium">Polling Centers</div>
            <div class="fs-4 fw-bold text-dark"><%= stats.reportingPUs %> / <%= stats.pollingUnits %></div>
            <div class="small text-muted">
              <%= stats.pollingUnits > 0 ? ((stats.reportingPUs / stats.pollingUnits) * 100).toFixed(0) : 0 %>% reporting
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm bg-white p-2">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-4 bg-warning-subtle text-warning p-3 me-3 flex-shrink-0">
            <i class="bi bi-trophy-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium">Leading Party</div>
            <div class="fs-4 fw-bold text-dark">
              <%= (partyStandings && partyStandings.length > 0) ? partyStandings[0].party_abbreviation : 'N/A' %>
            </div>
            <div class="small text-warning fw-semibold">
              <%= (partyStandings && partyStandings.length > 0 && totalStatewideVotes > 0) ? ((partyStandings[0].total_votes / totalStatewideVotes) * 100).toFixed(1) + '% share' : 'No votes yet' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="card h-100 border-0 shadow-sm bg-white p-2">
        <div class="card-body d-flex align-items-center">
          <div class="rounded-4 bg-info-subtle text-info p-3 me-3 flex-shrink-0">
            <i class="bi bi-building fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-medium">Delta State Coverage</div>
            <div class="fs-4 fw-bold text-dark"><%= stats.lgas %> LGAs</div>
            <div class="small text-info fw-semibold"><%= stats.wards %> Wards</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Statewide Party Standings & Chart Section -->
  <div class="row g-4 mb-4">
    <!-- Party Leaderboard Table -->
    <div class="col-lg-7">
      <div class="card border shadow-sm h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="fw-bold mb-0">
              <i class="bi bi-bar-chart-line-fill text-success me-2"></i>
              Statewide Party Standings
            </h5>
            <div class="text-muted small">Aggregated from all verified polling unit ballot returns</div>
          </div>
          <span class="badge bg-success-subtle text-success border border-success-subtle">
            <%= partyStandings.length %> Parties
          </span>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-3">Rank & Party</th>
                  <th scope="col">Total Ballots</th>
                  <th scope="col" style="width: 40%;">Vote Share (%)</th>
                  <th scope="col" class="text-end pe-3">Standing</th>
                </tr>
              </thead>
              <tbody>
                <% partyStandings.forEach((p, idx) => { 
                  const pct = totalStatewideVotes > 0 ? ((p.total_votes / totalStatewideVotes) * 100).toFixed(1) : 0;
                %>
                  <tr class="<%= idx === 0 ? 'table-success-subtle' : '' %>">
                    <td class="ps-3">
                      <span class="fw-bold text-muted me-2 small">#<%= idx + 1 %></span>
                      <span class="badge <%= idx === 0 ? 'bg-success' : 'bg-dark' %> px-2 py-1 fs-6">
                        <%= p.party_abbreviation %>
                      </span>
                    </td>
                    <td class="fw-bold fs-6">
                      <%= Number(p.total_votes).toLocaleString() %>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <span class="me-2 small fw-semibold" style="min-width: 45px;"><%= pct %>%</span>
                        <div class="progress flex-grow-1" style="height: 8px;">
                          <div class="progress-bar <%= idx === 0 ? 'bg-success' : 'bg-primary' %>" 
                               role="progressbar" 
                               style="width: <%= pct %>%;" 
                               aria-valuenow="<%= pct %>" 
                               aria-valuemin="0" 
                               aria-valuemax="100">
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="text-end pe-3">
                      <% if (idx === 0) { %>
                        <span class="badge bg-warning text-dark"><i class="bi bi-crown-fill me-1"></i> Leading</span>
                      <% } else { %>
                        <span class="small text-muted"><%= pct %>%</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
              <tfoot class="table-light">
                <tr class="fw-bold">
                  <td class="ps-3">TOTAL STATE BALLOTS</td>
                  <td class="text-success fs-6"><%= Number(totalStatewideVotes).toLocaleString() %></td>
                  <td>100.0%</td>
                  <td class="text-end pe-3">Verified</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Statewide Visual Distribution Chart -->
    <div class="col-lg-5">
      <div class="card border shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-pie-chart-fill text-primary me-2"></i>
            Vote Distribution Share
          </h5>
        </div>
        <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
          <canvas id="statewideChart" style="max-height: 290px; width: 100%;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Local Government Area (LGA) Directory Grid -->
  <div class="card border shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
          <h5 class="fw-bold mb-0">
            <i class="bi bi-grid-3x3-gap-fill text-success me-2"></i>
            Local Government Directory (Delta State)
          </h5>
          <div class="text-muted small">Browse collation summaries for all 25 Local Government Areas</div>
        </div>
        <!-- Live Instant Filter Input -->
        <div style="max-width: 280px; width: 100%;">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="lgaSearchInput" class="form-control border-start-0" placeholder="Filter LGA by name...">
          </div>
        </div>
      </div>
    </div>
    <div class="card-body p-3 bg-light">
      <div class="row g-2" id="lgaGridContainer">
        <% lgaSummaries.forEach(l => { 
          const hasReports = l.reporting_pus > 0;
        %>
          <div class="col-md-4 col-lg-3 lga-card-item" data-lga-name="<%= l.lga_name.toLowerCase() %>">
            <a href="/lga-total?lga_id=<%= l.lga_id %>" class="text-decoration-none">
              <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-lift transition">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="fw-bold text-dark"><%= l.lga_name %></span>
                  <% if (hasReports) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                      <%= l.reporting_pus %> reporting
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-muted border small">Pending</span>
                  <% } %>
                </div>
                <div class="d-flex justify-content-between align-items-center small text-muted">
                  <span><%= l.total_pus %> Polling Units</span>
                  <% if (l.total_votes > 0) { %>
                    <span class="fw-semibold text-success"><%= Number(l.total_votes).toLocaleString() %> votes</span>
                  <% } else { %>
                    <span>0 votes</span>
                  <% } %>
                </div>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Recent Reporting Polling Units Showcase -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h5 class="card-title fw-bold mb-0">
          <i class="bi bi-clock-history text-success me-2"></i> Recently Reported Polling Units
        </h5>
        <div class="text-muted small">Latest certified unit-level ballot returns received</div>
      </div>
      <a href="/polling-unit" class="btn btn-sm btn-outline-success">Browse All Units &rarr;</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3">Unit ID</th>
              <th scope="col">Polling Unit Name</th>
              <th scope="col">Code / Number</th>
              <th scope="col">Local Government</th>
              <th scope="col">Total Recorded Ballots</th>
              <th scope="col" class="text-end pe-3">Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentUnits && recentUnits.length > 0) { %>
              <% recentUnits.forEach(u => { %>
                <tr>
                  <td class="ps-3 fw-bold text-success">#<%= u.uniqueid %></td>
                  <td class="fw-medium"><%= u.polling_unit_name %></td>
                  <td><code><%= u.polling_unit_number || 'N/A' %></code></td>
                  <td><span class="badge bg-light text-dark border"><%= u.lga_name || 'Delta LGA' %></span></td>
                  <td>
                    <span class="fw-bold text-success"><%= Number(u.total_votes || 0).toLocaleString() %></span> votes
                  </td>
                  <td class="text-end pe-3">
                    <a href="/polling-unit?id=<%= u.uniqueid %>" class="btn btn-sm btn-outline-success">
                      View Results <i class="bi bi-chevron-right"></i>
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No reporting polling units found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</main>

<!-- Interactive Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Instant LGA Directory Search / Filter
    const searchInput = document.getElementById('lgaSearchInput');
    const items = document.querySelectorAll('.lga-card-item');

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.trim().toLowerCase();
        items.forEach(item => {
          const name = item.getAttribute('data-lga-name') || '';
          if (name.includes(query)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // 2. Statewide Votes Doughnut Chart
    const chartCtx = document.getElementById('statewideChart').getContext('2d');
    const labels = <%- JSON.stringify(partyStandings.map(p => p.party_abbreviation)) %>;
    const votes = <%- JSON.stringify(partyStandings.map(p => p.total_votes)) %>;

    const palette = [
      '#198754', '#0d6efd', '#ffc107', '#dc3545', '#6f42c1', 
      '#fd7e14', '#20c997', '#0dcaf0', '#6c757d'
    ];

    new Chart(chartCtx, {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: votes,
          backgroundColor: palette.slice(0, labels.length),
          borderWidth: 2,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: function(context) {
                return ` ${context.label}: ${context.raw.toLocaleString()} votes`;
              }
            }
          }
        }
      }
    });
  });
</script>

<%- include('../partials/footer') %>
