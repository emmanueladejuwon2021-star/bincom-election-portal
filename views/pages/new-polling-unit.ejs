<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-4 flex-grow-1">

  <!-- Executive Hero Banner -->
  <div class="hero-banner p-3 p-md-5 mb-4 rounded-4 shadow-sm text-white" 
       style="background: linear-gradient(135deg, #064e3b 0%, #047857 55%, #0d9488 100%); position: relative; overflow: hidden;">
    
    <!-- Watermark Icon -->
    <div style="position: absolute; right: -25px; bottom: -30px; opacity: 0.12; pointer-events: none;">
      <i class="bi bi-pencil-square" style="font-size: 16rem;"></i>
    </div>

    <div class="row align-items-center position-relative" style="z-index: 1;">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill bg-white bg-opacity-20 text-white small fw-medium backdrop-blur">
          <i class="bi bi-shield-lock-fill text-warning"></i>
          Presiding Officer Official Entry &bull; Delta State
        </div>
        <h1 class="display-6 fw-extrabold mb-2 text-white">Submit Polling Unit Ballot Returns</h1>
        <p class="lead text-white text-opacity-90 mb-0" style="max-width: 620px;">
          Register a voting center and record certified ballot returns for all contesting political parties in accordance with electoral guidelines.
        </p>
      </div>

      <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
        <a href="/polling-unit" class="btn btn-warning text-dark fw-bold px-4 py-2 shadow-sm">
          <i class="bi bi-search me-1"></i> Browse Existing Units
        </a>
      </div>
    </div>
  </div>

  <% if (successMessage && createdPuId) { %>
    <!-- Success Banner -->
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-4 border-0 p-4" role="alert">
      <div class="d-flex align-items-center">
        <div class="rounded-circle bg-success text-white p-3 me-3 d-inline-flex">
          <i class="bi bi-check-lg fs-3"></i>
        </div>
        <div>
          <h5 class="alert-heading fw-extrabold mb-1">Results Successfully Certified & Recorded!</h5>
          <p class="mb-0 text-secondary">
            Polling unit registered under ID <strong>#<%= createdPuId %></strong>. Certified ballot counts for all <%= parties.length %> political parties have been securely stored in the system.
          </p>
        </div>
      </div>
      <div class="mt-3 ps-5">
        <a href="/polling-unit?id=<%= createdPuId %>" class="btn btn-success fw-bold px-4 py-2 rounded-3 me-2 shadow-xs">
          <i class="bi bi-eye-fill me-1"></i> View Saved Returns
        </a>
        <a href="/new-polling-unit" class="btn btn-outline-success fw-semibold px-3 py-2 rounded-3">
          <i class="bi bi-plus-lg me-1"></i> Submit Another Unit
        </a>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <form action="/new-polling-unit" method="POST" id="newPuForm" class="needs-validation">
    <div class="row g-4">
      <!-- Section 1: Polling Unit Details (Left Column) -->
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
          <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
            <div class="rounded-3 bg-success-subtle text-success p-2 me-2 d-inline-flex">
              <i class="bi bi-geo-alt-fill fs-5"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0 text-dark">Step 1: Voting Center Details</h5>
              <div class="text-muted small">Location, designation, and presiding officer</div>
            </div>
          </div>
          <div class="card-body p-4">
            <!-- LGA Select -->
            <div class="mb-3">
              <label for="newPuLga" class="form-label fw-bold small text-muted text-uppercase">
                Local Government Area (LGA) <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-building"></i></span>
                <select class="form-select form-select-lg border-start-0 py-2" id="newPuLga" name="lga_id" required>
                  <option value="">-- Choose LGA --</option>
                  <% lgas.forEach(l => { %>
                    <option value="<%= l.lga_id %>"><%= l.lga_name %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <!-- Ward Select (Dynamic) -->
            <div class="mb-3">
              <label for="newPuWard" class="form-label fw-bold small text-muted text-uppercase">
                Ward <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-pin-map"></i></span>
                <select class="form-select form-select-lg border-start-0 py-2" id="newPuWard" name="ward_id" required disabled>
                  <option value="">-- Choose LGA first --</option>
                </select>
              </div>
              <div class="form-text small">Wards will load dynamically based on the chosen LGA.</div>
            </div>

            <!-- Polling Unit Name -->
            <div class="mb-3">
              <label for="puName" class="form-label fw-bold small text-muted text-uppercase">
                Polling Unit Name <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                <input type="text" class="form-control border-start-0 py-2" id="puName" name="polling_unit_name" 
                       placeholder="e.g. St. Patrick Primary School Compound Unit 4" required>
              </div>
            </div>

            <!-- Polling Unit Number / Code -->
            <div class="mb-3">
              <label for="puNumber" class="form-label fw-bold small text-muted text-uppercase">
                Polling Unit Code / Number
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-hash"></i></span>
                <input type="text" class="form-control border-start-0 py-2" id="puNumber" name="polling_unit_number" 
                       placeholder="e.g. DT1708099 (Leave blank to generate automatically)">
              </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
              <label for="puDesc" class="form-label fw-bold small text-muted text-uppercase">
                Landmark / Location Description
              </label>
              <textarea class="form-control" id="puDesc" name="polling_unit_description" rows="2" 
                        placeholder="e.g. Near main community market entrance, opposite church gate"></textarea>
            </div>

            <!-- Lat & Long -->
            <div class="row g-2 mb-3">
              <div class="col-6">
                <label for="puLat" class="form-label small fw-bold text-muted text-uppercase">Latitude (Optional)</label>
                <input type="text" class="form-control" id="puLat" name="lat" placeholder="e.g. 5.5937">
              </div>
              <div class="col-6">
                <label for="puLong" class="form-label small fw-bold text-muted text-uppercase">Longitude (Optional)</label>
                <input type="text" class="form-control" id="puLong" name="long" placeholder="e.g. 5.9993">
              </div>
            </div>

            <!-- Presiding Officer -->
            <div class="mb-2">
              <label for="enteredBy" class="form-label fw-bold small text-muted text-uppercase">
                Presiding Officer Designation
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person-badge"></i></span>
                <input type="text" class="form-control border-start-0 py-2" id="enteredBy" name="entered_by_user" 
                       value="INEC Presiding Officer">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Party Scores (Right Column) -->
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="rounded-3 bg-success-subtle text-success p-2 me-2 d-inline-flex">
                <i class="bi bi-card-checklist fs-5"></i>
              </div>
              <div>
                <h5 class="fw-bold mb-0 text-dark">Step 2: Contesting Party Votes</h5>
                <div class="text-muted small">Enter certified counts from results sheet</div>
              </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
              <%= parties.length %> Parties
            </span>
          </div>
          <div class="card-body p-4">
            <p class="text-muted small mb-3">
              Type in the verified vote count for each political party. The live tally updates automatically.
            </p>

            <div class="row g-3">
              <% parties.forEach(p => { %>
                <div class="col-md-6">
                  <div class="p-3 border rounded-3 bg-light party-input-card hover-lift">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <label for="score_<%= p.partyid %>" class="form-label fw-bold mb-0">
                        <span class="badge bg-dark px-2 py-1 fs-6 rounded-2"><%= p.partyid %></span>
                      </label>
                      <span class="text-muted small fw-medium"><%= p.partyname %></span>
                    </div>
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-pencil-fill"></i></span>
                      <input type="number" 
                             class="form-control form-control-lg border-start-0 party-score-input fw-bold fs-5" 
                             id="score_<%= p.partyid %>" 
                             name="score_<%= p.partyid %>" 
                             min="0" 
                             value="0" 
                             required>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>

            <!-- Live Total Votes Banner -->
            <div class="mt-4 p-3 bg-success-subtle border border-success-subtle rounded-4 text-success d-flex justify-content-between align-items-center">
              <div>
                <span class="fw-bold text-uppercase small d-block">Total Ballots Counted</span>
                <span class="small text-muted">Sum of all party entries</span>
              </div>
              <div class="display-6 fw-extrabold text-success" id="liveTotalDisplay">
                0
              </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-4">
              <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-xs py-3 rounded-3">
                <i class="bi bi-check-circle-fill me-2"></i> Submit & Save Verified Returns
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</main>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const lgaSelect = document.getElementById('newPuLga');
    const wardSelect = document.getElementById('newPuWard');
    const scoreInputs = document.querySelectorAll('.party-score-input');
    const liveTotalDisplay = document.getElementById('liveTotalDisplay');

    // Chained Ward Dropdown
    lgaSelect.addEventListener('change', async function() {
      const lgaId = this.value;
      wardSelect.innerHTML = '<option value="">-- Choose Ward --</option>';

      if (!lgaId) {
        wardSelect.disabled = true;
        return;
      }

      wardSelect.disabled = false;
      try {
        const res = await fetch(`/api/wards?lga_id=${lgaId}`);
        const data = await res.json();
        if (data.success && data.data) {
          data.data.forEach(w => {
            const opt = document.createElement('option');
            opt.value = w.ward_id;
            opt.textContent = w.ward_name;
            wardSelect.appendChild(opt);
          });
        }
      } catch (err) {
        console.error('Error loading wards:', err);
      }
    });

    // Live total votes calculation
    function updateTotal() {
      let sum = 0;
      scoreInputs.forEach(input => {
        const val = parseInt(input.value, 10);
        if (!isNaN(val) && val >= 0) {
          sum += val;
        }
      });
      liveTotalDisplay.textContent = sum.toLocaleString();
    }

    scoreInputs.forEach(input => {
      input.addEventListener('input', updateTotal);
      input.addEventListener('change', updateTotal);
    });

    updateTotal();
  });
</script>

<%- include('../partials/footer') %>
