<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container my-5 flex-grow-1 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card border-danger shadow-sm p-4">
        <div class="card-body">
          <i class="bi bi-exclamation-triangle-fill text-danger display-3 mb-3 d-block"></i>
          <h3 class="fw-bold text-danger">An Error Occurred</h3>
          <p class="text-muted"><%= error || 'The requested resource could not be found or processed.' %></p>
          <div class="mt-4">
            <a href="/" class="btn btn-outline-secondary me-2">Back to Dashboard</a>
            <a href="/polling-unit" class="btn btn-success">View Polling Units</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
